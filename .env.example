# Copy to .env and adjust:  cp .env.example .env

AUTH_USER=jakob

# Generate the password hash (prompts for the password):
#   docker compose run --rm workoutbuddy hash-password
# Paste the output here – keep the single quotes because of the $ characters.
AUTH_PASSWORD_HASH='$2a$10$replace-me'

# IP of your Caddy reverse proxy. Only requests from this address may set
# X-Forwarded-For / X-Forwarded-Proto (real client IP for the login rate limit,
# Secure cookie flag). Comma-separated IPs or CIDR ranges.
TRUSTED_PROXIES=192.168.178.20

# Optional
# WORKOUT_PORT=8080      # host port the container is published on
# SESSION_DAYS=30        # how long you stay logged in (sliding)
# MAX_UPLOAD_MB=500      # max size of a recorded clip
