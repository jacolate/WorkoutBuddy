# Kopieren nach .env und anpassen:  cp .env.example .env

AUTH_USER=jakob

# Passwort-Hash erzeugen (fragt das Passwort verdeckt ab):
#   docker compose run --rm workout hash-password
# Ausgabe hier einfügen – WICHTIG: in einfache Anführungszeichen, wegen der $-Zeichen.
AUTH_PASSWORD_HASH='$2a$10$ersetzen...'

# IP-Adresse(n)/Hostnamen des Servers, für die das selbstsignierte Zertifikat gelten soll (kommagetrennt).
TLS_HOSTS=192.168.178.10,homeserver.lan

# Nur setzen, wenn ein Reverse-Proxy davor sitzt (X-Forwarded-For/Proto werden dann ausgewertet):
# TRUST_PROXY=true
# TLS_MODE=off
